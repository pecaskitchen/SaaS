    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "sharp": "0.35.5",
        "source-map-js": "1.2.2",
        "wrangler": "^4.147.0"
    },
    "overrides": {
        "sharp": "0.35.5",
        "source-map-js": "1.2.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "sharp@0.35.5": true,
        "workerd@1.20261001.1": true
